# Template for local development. Copy to application-local.properties and fill in.
# The real file is gitignored; this one is committed so a new machine knows what is needed.
#
#   cp application-local.properties.example application-local.properties
#
# The JWT secret must be at least 32 bytes for HS256. Generate one with:
#   openssl rand -base64 48
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME
jwt.secret=CHANGE_ME_AT_LEAST_32_BYTES_LONG
