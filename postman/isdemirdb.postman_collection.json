      "item": [
        {
          "name": "GET Döküm Detay - Olmayan id → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 döndü', () => pm.response.to.have.status(404));",
